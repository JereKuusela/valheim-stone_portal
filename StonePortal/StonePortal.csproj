<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <nullable>enable</nullable>
    <DoILRepack>false</DoILRepack>
  </PropertyGroup>
  <Target Name="ILRepacker" AfterTargets="Build" >
      <ItemGroup>
          <InputAssemblies Include="$(TargetPath)" />
          <InputAssemblies Include="$(LibsDir)\ServerSync.dll" />
      </ItemGroup>
      <ILRepack Parallel="true" Internalize="true" InputAssemblies="@(InputAssemblies)" TargetKind="Dll" OutputFile="$(TargetPath)" />
  </Target>
  <Target Name="CopyDLL" AfterTargets="ILRepacker">
    <Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(LibsDir)" />
    <Message Text="Copied to Libs folder." Importance="High" />
  </Target>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
    <Reference Include="BepInEx.dll">
      <HintPath>$(BepInExDir)\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.dll">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule.dll">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI.dll">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule.dll">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony.dll">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Harmony.dll">
      <HintPath>$(BepInExDir)\BepInEx.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim_publicized.dll" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils_publicized.dll" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils_publicized.dll" Publicize="true">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="ServerSync.dll">
      <HintPath>$(LibsDir)\ServerSync.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild" Version="2.1.18" />
  </ItemGroup>
</Project>
